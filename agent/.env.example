# 变量清单。应用本身不加载 .env，启动时用 `uv run --env-file .env python -m feishubot_agent`，
# 或由容器 / systemd 注入。已在进程环境里的变量优先。
# 本地开发时复制成 .env（已在 .gitignore 里），不要提交。

# ---- DeepSeek 凭据 ----
# 在 https://platform.deepseek.com/api_keys 申请。
DEEPSEEK_API_KEY=
# OpenAI 兼容端点。默认就是 DeepSeek 官方地址；用代理/网关时改这里。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 服务监听 ----
# 默认 127.0.0.1；容器里必须改成 0.0.0.0，否则发布了端口也没用。
AGENT_HOST=127.0.0.1
# 8000 是机器人，8003 是 MCP，这里避开它们。
AGENT_PORT=9003

# ---- MCP 工具服务 ----
AGENT_MCP_URL=http://127.0.0.1:8003/mcp
# 与 MCP 服务 MCP_AUTH_TOKENS 里本调用方那一行冒号后面的值一致。
# MCP 侧留空不校验时可以也留空；线上必须填。
AGENT_MCP_TOKEN=

# 单次工具调用的客户端超时（秒）。要**略大于** MCP 服务端的
# MCP_TOOL_TIMEOUT_SECONDS（默认 30），让服务端的结构化超时先回来。
AGENT_MCP_TIMEOUT_SECONDS=35

# ---- 模型 ----
# 默认 deepseek-v4-pro。deepseek-flash 更快，但在本机实测中多次出现输出
# 拼接/乱码（例如 `帮import`、`<response>`），需要时再自行切回并观察。
AGENT_MODEL=deepseek-v4-pro
# none 关闭思考，low / high / max 开启并控制强度。默认 none，延迟最低。
# 实测简单工具调用在 none 下仍能正确选工具；复杂多步任务再调到 high。
# （low 在本机实测反而比 high 慢，不建议作为折中。）
AGENT_REASONING_EFFORT=none

# ---- 回合预算 ----
# 一次用户消息里最多允许几轮"模型 → 工具"。
AGENT_MAX_STEPS=8
# 整个回合的上限。必须**小于** backend routes.json 里这条路由的 timeoutSeconds，
# 否则 backend 先放弃，agent 还在后台跑。
AGENT_TURN_TIMEOUT_SECONDS=100

# ---- 会话 ----
# 会话空闲多久后丢弃历史（秒）。
AGENT_SESSION_IDLE_TTL_SECONDS=1800
# 同一会话的上一条还在处理时，新消息最多等多久（秒）。超时回「上一条还在处理」，
# 不无限排队。
AGENT_SESSION_LOCK_WAIT_SECONDS=10
# 保留最近多少个用户回合；超出的从最旧的开始裁掉，不做摘要。
AGENT_HISTORY_MAX_TURNS=20
