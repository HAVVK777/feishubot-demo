# 飞书后台「凭证与基础信息」页
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书后台「事件与回调 → 加密策略」页
# 留空则不校验回调来源（本地演示可以留空，线上必须填）
FEISHU_VERIFICATION_TOKEN=

# 本服务监听地址
FEISHU_BOT_HOST=127.0.0.1
FEISHU_BOT_PORT=8000

# 关键字 → 外部服务 的注册表。默认是工作目录下的 routes.json。
# 把真实 token 写进 routes.json 之后，建议改用 routes.local.json（已在 .gitignore 里）
# FEISHU_ROUTES_FILE=routes.local.json

# 飞书开放平台地址。只在测试/演示指向假服务时才需要改
# FEISHU_BASE_URL=https://open.feishu.cn
