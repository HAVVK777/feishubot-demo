# 飞书后台「凭证与基础信息」页
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书后台「事件与回调 → 加密策略」页
# 留空则不校验回调来源（本地演示可以留空，线上必须填）
FEISHU_VERIFICATION_TOKEN=

# 本服务监听地址
FEISHU_BOT_HOST=127.0.0.1
FEISHU_BOT_PORT=8000

# 关键字 → 外部服务 的注册表。默认是工作目录下的 routes.json。
# Docker 部署时 compose.yaml 会把它设成 /app/routes.json，一般不用动这里。
# FEISHU_ROUTES_FILE=routes.json

# 飞书开放平台地址。只在测试/演示指向假服务时才需要改
# FEISHU_BASE_URL=https://open.feishu.cn

# 以下两个只被 compose.yaml 读（端口映射的 `${...}` 插值），应用本身不认。
# 飞书回调地址要带上发布端口：http://<公网IP>:<发布端口>/feishu/events
FEISHU_BOT_PUBLISH_PORT=8000
# 发布到哪个地址。默认只绑本地、由 nginx 转发进来；要直接暴露公网改成 0.0.0.0
FEISHU_BOT_BIND_ADDR=127.0.0.1
