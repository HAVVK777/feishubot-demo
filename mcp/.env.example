# 变量清单。启动时应用会**自己加载当前目录的 .env**（不是 dotenv，见 env_file.py）；
# 已在环境里的变量优先——容器 / systemd 注入的值不会被文件覆盖。
# 路径可以用 MCP_ENV_FILE 改。详细说明见 README「配置」一节。

# 监听地址。默认 127.0.0.1；容器里必须改成 0.0.0.0，否则发布了端口也没用。
MCP_HOST=127.0.0.1

# 本项目部署使用 8003（8000 是机器人，8002 是 agent）。
MCP_PORT=8003

# 协议端点路径，默认 /mcp。
MCP_PATH=/mcp

# 调用方 token 表：`名字:token`，逗号分隔，一个调用方一行。
# 名字只用来记日志和归因（工具里能读到），不参与校验；重名允许——轮换时同一个
# agent 的新旧 token 会短暂并存。
# 留空则不校验来源，知道地址的人都能调工具；线上必须填。
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 例：MCP_AUTH_TOKENS="feishu-agent:1JqXk...,ops-agent:9Rb3v..."
MCP_AUTH_TOKENS=

# 旧式的单个 token（没有名字）。不要和上面那个同时设——同时设会拒绝启动，
# 免得一个已经不该用的 token 还在悄悄放行。迁移时把它并进上面那行即可。
MCP_AUTH_TOKEN=

# 反代到公网时放行哪些 Host 头（逗号分隔）。留空 = 不开 DNS rebinding 防护。
# 常带端口就写成 mcp.example.com:*，否则只按你写的那串字符精确/前缀匹配，
# 漏写的后果是请求被回 421 Invalid Host header。
MCP_ALLOWED_HOSTS=

# 浏览器里的客户端会带 Origin 头，需要在这里放行；命令行客户端不带，不用配。
MCP_ALLOWED_ORIGINS=

# ---- 限流（单位都是"次/分钟"，0 = 不限）----

# 总闸：每个调用方（agent）每分钟最多多少次工具调用。
# 这条链路上 MCP 通常只看到一个调用方，所以它就是整个服务的天花板。
# 定值参考：并发会话数 × 单会话额度，留出余量。
MCP_RATE_LIMIT_PER_MINUTE=

# 单聊：每个飞书会话每分钟最多多少次。
MCP_SESSION_RATE_LIMIT_PER_MINUTE=

# 群聊：每个群每分钟最多多少次。群聊的额度是全群共享的（一个人能用光），
# 所以值得单独定。**不配就跟随上面那个**，不会因为少配就放成不限。
MCP_GROUP_RATE_LIMIT_PER_MINUTE=

# 单次工具调用的上限（秒）。0 = 不限，那样卡住的工具会把请求一直挂着。
MCP_TOOL_TIMEOUT_SECONDS=30

# ---- 工具自己的配置（不是服务本身的开关）----

# 飞书自建应用凭据：get_leave_days 用。可以和机器人（backend/）是同一个应用，
# 也可以是另一个——取决于权限怎么给。没配的话工具调用时会返回明确的错误，服务照常启动。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 请假数据源：一张**由飞书审批同步过来的**多维表格。
# app token 在表格 URL 的 base/ 后面；table id 在 table= 后面。
# 应用还需要在多维表格里被加为「文档应用」（不是"协作者"），否则接口报 91403。
FEISHU_LEAVE_BITABLE_APP_TOKEN=
FEISHU_LEAVE_BITABLE_TABLE_ID=

# 列名。默认就是这几个，表格里改名了才需要配。
# FEISHU_LEAVE_FIELD_USER=用户       # 人员字段
# FEISHU_LEAVE_FIELD_TIME=开始时间   # 日期
# FEISHU_LEAVE_FIELD_DAYS=时长       # 数字，0.5 天为单位
# FEISHU_LEAVE_FIELD_STATUS=审批结果 # 文本，只有「通过」的行才计入
